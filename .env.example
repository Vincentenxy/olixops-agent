# Prefer: uv run python scripts/init_local.py (generates a private local DB password).
# Environment settings for local development. Never commit a real .env.
OLIXOPS_MODE=debug
OLIXOPS_HOST=127.0.0.1
OLIXOPS_PORT=8000
OLIXOPS_DOCS_ENABLED=true
OLIXOPS_LOCAL_DB_PASSWORD=replace-with-a-random-local-password
OLIXOPS_DATABASE_URL=postgresql+psycopg://olixops:replace-with-a-random-local-password@127.0.0.1:15432/olixops
OLIXOPS_REDIS_URL=redis://127.0.0.1:16379/0
OLIXOPS_JWT_PRIVATE_KEY_PATH=runtime/keys/jwt-private.pem
OLIXOPS_JWT_PUBLIC_KEY_PATH=runtime/keys/jwt-public.pem
OLIXOPS_REFRESH_COOKIE_SECURE=false
OLIXOPS_BROWSER_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:5175","http://localhost:5175","http://127.0.0.1:8080","http://localhost:8080"]
OLIXOPS_PULUMI_CLI=pulumi
