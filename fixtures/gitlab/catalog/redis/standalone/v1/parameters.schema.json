{
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "namespace", "image", "replicas"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$", "maxLength": 63},
    "namespace": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$", "maxLength": 63},
    "image": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9./:@_-]*$", "maxLength": 256},
    "replicas": {"type": "integer", "const": 1},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535}
  }
}
